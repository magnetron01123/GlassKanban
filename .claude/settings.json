{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/scripts/doc-guard.sh\" --session-start",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/scripts/build-app.sh\" --session-start",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/scripts/doc-guard.sh\" --stop",
            "timeout": 15,
            "statusMessage": "Doku-Wächter prüft"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/scripts/build-app.sh\" --stop",
            "timeout": 15,
            "statusMessage": "App-Build wird geprüft"
          }
        ]
      }
    ]
  }
}
